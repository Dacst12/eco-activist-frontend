# Адрес бэкенда
API_URL=http://localhost:5000
# Включить моки MSW вместо настоящего API
NEXT_PUBLIC_USE_MOCKS=true
# Ключ JavaScript API Яндекс Карт
NEXT_PUBLIC_YMAPS_KEY=
# Сервер геокодирования
NEXT_PUBLIC_GEOCODER_URL=
# Для доступа к dev-серверу по IP или локальному домену. Для localhost можно оставить пустым.
ALLOWED_DEV_ORIGINS=